# Let's Encrypt DNS-01 via Cloudflare (CF_DNS_API_TOKEN in .env, Zone:DNS:Edit).
# Works for LAN-only hostnames: nothing has to be reachable from the internet.
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_DNSCHALLENGE_PROVIDER=cloudflare
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_DNSCHALLENGE_RESOLVERS=1.1.1.1:53,1.0.0.1:53
